# Copy to backend/.env (or set as real environment variables in your deployment
# platform). Do not commit a real .env file or real secrets.

IDEV_APP_NAME=Intelligent Document Extraction & Validation API
IDEV_APP_ENV=production
IDEV_LOG_LEVEL=INFO
IDEV_API_V1_PREFIX=/api/v1

# SQLite by default; point this at Postgres/MySQL in production, e.g.
# postgresql+psycopg2://user:password@host:5432/dbname
IDEV_DATABASE_URL=sqlite:///./data/documents.db

IDEV_MAX_PAGES=3
IDEV_MAX_UPLOAD_SIZE_MB=15

IDEV_OCR_DPI=200
IDEV_OCR_MIN_NATIVE_TEXT_CHARS=20
# Only needed if tesseract is not on PATH:
# IDEV_TESSERACT_CMD=/usr/bin/tesseract

IDEV_FINANCIAL_TOLERANCE_ABSOLUTE=1.0
IDEV_FINANCIAL_TOLERANCE_RELATIVE=0.01

# Optional LLM-assisted recovery of fields the rule-based extractor left null.
# Set NEITHER key to run the deterministic pipeline only: the service never
# calls a model silently, and never fails a document because a model is down.
#
# Gemini reads the rendered page image, which is what poor scans need, and is
# the recommended option. Get a key at https://aistudio.google.com/apikey and
# set it in your deployment platform's dashboard - never in this file.
# IDEV_GEMINI_API_KEY=
# IDEV_GEMINI_MODEL=gemini-flash-latest
#
# Anthropic is a text-only fallback over the OCR output.
# IDEV_LLM_API_KEY=
# IDEV_LLM_MODEL=claude-opus-5
# IDEV_LLM_MAX_TOKENS=16384

# OCR tuning (see the accuracy table in the README before changing these).
IDEV_OCR_PSM=3
IDEV_OCR_MIN_CONFIDENCE=30
